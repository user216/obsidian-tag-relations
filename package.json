{
	"name": "obsidian-tag-relations",
	"version": "0.8.0",
	"description": "Explore relations between tags as a tag cloud, mind-map and tree.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"package": "npm run build && node scripts/package.mjs",
		"test": "node tests/run.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tags",
		"graph"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.2",
		"obsidian": "^1.5.7",
		"tslib": "^2.6.2",
		"typescript": "^5.4.3"
	}
}
